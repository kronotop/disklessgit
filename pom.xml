<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.kronotop</groupId>
    <artifactId>disklessgit-root</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>DisklessGit Root</name>
    <description>Stateless Git server backed by Kronotop</description>
    <url>https://kronotop.com</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>buraksezer</id>
            <name>Burak Sezer</name>
            <email>burak.sezer@kronotop.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/kronotop/disklessgit.git</connection>
        <developerConnection>scm:git:git@github.com:kronotop/disklessgit.git</developerConnection>
        <url>https://github.com/kronotop/disklessgit</url>
    </scm>

    <modules>
        <module>disklessgit</module>
        <module>disklessgit-ui</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions -->
        <logback.version>1.6.6</logback.version>
        <picocli.version>4.7.7</picocli.version>
        <typesafe-config.version>1.4.10</typesafe-config.version>
        <guava.version>33.8.0-jre</guava.version>
        <jgit.version>7.8.1.202611041320-r</jgit.version>
        <jetty.version>12.1.15</jetty.version>
        <jedis.version>8.0.2</jedis.version>
        <bson.version>5.6.1</bson.version>
        <jackson.version>3.3.0</jackson.version>
        <gitiles.version>2.0.0</gitiles.version>
        <soy.version>2024-01-30</soy.version>
        <commonmark.version>0.21.0</commonmark.version>
        <commons-lang3.version>3.22.0</commons-lang3.version>
        <commons-text.version>1.15.0</commons-text.version>
        <java-prettify.version>1.2.2</java-prettify.version>

        <!-- Plugin versions -->
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <git-commit-id-maven-plugin.version>10.0.1</git-commit-id-maven-plugin.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- Build an executable JAR -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <mainClass>${main.class}</mainClass>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <version>${git-commit-id-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>get-the-git-infos</id>
                            <goals>
                                <goal>revision</goal>
                            </goals>
                            <phase>initialize</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <generateGitPropertiesFile>false</generateGitPropertiesFile>
                        <failOnNoGitDirectory>false</failOnNoGitDirectory>
                        <includeOnlyProperties>
                            <includeOnlyProperty>^git\.commit\.id\.abbrev$</includeOnlyProperty>
                            <includeOnlyProperty>^git\.build\.time$</includeOnlyProperty>
                        </includeOnlyProperties>
                        <dateFormat>yyyy-MM-dd'T'HH:mm:ssXXX</dateFormat>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>shade</id>
                            <phase>package</phase>
                            <goals>
                                <goal>shade</goal>
                            </goals>
                            <configuration>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                                <filters>
                                    <filter>
                                        <!-- Drop dependency signatures and module descriptors that break a merged jar -->
                                        <artifact>*:*</artifact>
                                        <excludes>
                                            <exclude>META-INF/*.SF</exclude>
                                            <exclude>META-INF/*.DSA</exclude>
                                            <exclude>META-INF/*.RSA</exclude>
                                            <exclude>META-INF/versions/*/module-info.class</exclude>
                                            <exclude>module-info.class</exclude>
                                        </excludes>
                                    </filter>
                                </filters>
                                <transformers>
                                    <transformer
                                            implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                        <mainClass>${main.class}</mainClass>
                                        <manifestEntries>
                                            <Multi-Release>true</Multi-Release>
                                        </manifestEntries>
                                    </transformer>
                                    <transformer
                                            implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                    <transformer
                                            implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                        <!-- Merge HOCON reference.conf files from all jars instead of keeping only one -->
                                        <resource>reference.conf</resource>
                                    </transformer>
                                </transformers>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
